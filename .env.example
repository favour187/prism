# ---------- Prism configuration ----------
# Copy to .env (server reads it automatically) or set these in Render's dashboard.

# REQUIRED in production: your xAI/Grok API key. Never put this in the frontend.
# Create a key in the xAI Console: https://console.x.ai/
GROK_API_KEY=
# XAI_API_KEY is also accepted as an alias.

# OpenAI-compatible xAI endpoint.
GROK_BASE_URL=https://api.x.ai/v1
GROK_CHAT_MODEL=grok-4.7
GROK_VISION_MODEL=grok-4.7
AI_PROVIDER=grok
GROK_MAX_TOKENS=4096
GROK_TEMPERATURE=0.6
GROK_TIMEOUT_MS=120000

# Optional legacy provider if you explicitly choose AI_PROVIDER=featherless.
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_CHAT_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct
FEATHERLESS_VISION_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
FEATHERLESS_STT_MODEL=openai/whisper-large-v3

# ---------- Server ----------
PORT=4000
HOST=0.0.0.0
# DATA_DIR holds the SQLite DB + uploads. On Render, mount a disk and point here, e.g. /var/data
# DATA_DIR=/var/data

# ---------- Limits / tuning ----------
MAX_UPLOAD_MB=12
MAX_UPLOAD_FILES=6
MAX_INLINE_IMAGE_MB=9
MAX_AUDIO_MB=15
HISTORY_MESSAGES=24
MAX_CONTEXT_FILES_CHARS=180000
MAX_FILE_CHARS=40000
FEATHERLESS_MAX_TOKENS=4096
FEATHERLESS_TEMPERATURE=0.6
FEATHERLESS_TIMEOUT_MS=120000

# ---------- Rate limiting ----------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_API_MAX=600
RATE_LIMIT_CHAT_MAX=40
RATE_LIMIT_UPLOAD_MAX=60

# ---------- CORS ----------
# Only needed when hosting the frontend on a DIFFERENT origin (comma-separated).
# CORS_ORIGINS=https://prism-app.example.com
