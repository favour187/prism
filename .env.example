# ---------- Prism configuration ----------
# Keep provider keys server-side only. Never put them in client-side variables.

# Primary AI: Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_CHAT_MODEL=gemini-3.5-flash
GEMINI_VISION_MODEL=gemini-3.5-flash
GEMINI_MAX_TOKENS=4096
GEMINI_TEMPERATURE=0.6
GEMINI_TIMEOUT_MS=120000

# Backup AI + Whisper speech-to-text: GroqCloud key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_CHAT_MODEL=qwen/qwen3.8-27b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_STT_BASE_URL=https://api.groq.com/openai/v1
GROQ_MAX_TOKENS=4096
GROQ_TEMPERATURE=0.6
GROQ_TIMEOUT_MS=120000
AI_PROVIDER=gemini

# Optional legacy provider, only if AI_PROVIDER=featherless.
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_CHAT_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct
FEATHERLESS_VISION_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
FEATHERLESS_STT_MODEL=openai/whisper-large-v3

# ---------- Server ----------
PORT=4000
HOST=0.0.0.0
# DATA_DIR holds the SQLite DB + uploads. On Render, mount a disk and point here, e.g. /var/data
# DATA_DIR=/var/data

# ---------- Limits / tuning ----------
MAX_UPLOAD_MB=12
MAX_UPLOAD_FILES=6
MAX_INLINE_IMAGE_MB=9
MAX_AUDIO_MB=15
HISTORY_MESSAGES=24
MAX_CONTEXT_FILES_CHARS=180000
MAX_FILE_CHARS=40000
FEATHERLESS_MAX_TOKENS=4096
FEATHERLESS_TEMPERATURE=0.6
FEATHERLESS_TIMEOUT_MS=120000

# ---------- Rate limiting ----------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_API_MAX=600
RATE_LIMIT_CHAT_MAX=40
RATE_LIMIT_UPLOAD_MAX=60

# ---------- CORS ----------
# Only needed when hosting the frontend on a DIFFERENT origin (comma-separated).
# CORS_ORIGINS=https://prism-app.example.com
