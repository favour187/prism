# ---------- Prism configuration ----------
# Copy to .env (server reads it automatically) or set these in Render's dashboard.

# REQUIRED in production: your Featherless AI key. Never put this in the frontend.
# Get one at https://featherless.ai — keys stay server-side only.
FEATHERLESS_API_KEY=

# OpenAI-compatible endpoint (you almost never change this).
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1

# Models — pick any chat-capable model hosted on Featherless.
FEATHERLESS_CHAT_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct
FEATHERLESS_VISION_MODEL=Qwen/Qwen2.5-VL-72B-Instruct

# Voice input (speech-to-text): any OpenAI-compatible /audio/transcriptions endpoint.
# Defaults to the main base URL; override if your STT lives elsewhere (e.g. a local whisper.cpp server).
FEATHERLESS_STT_MODEL=openai/whisper-large-v3
# FEATHERLESS_STT_BASE_URL=http://localhost:8080/v1

# Provider selection: 'featherless' (default/production) or 'mock' (local dev/CI only).
AI_PROVIDER=featherless

# ---------- Server ----------
PORT=4000
HOST=0.0.0.0
# DATA_DIR holds the SQLite DB + uploads. On Render, mount a disk and point here, e.g. /var/data
# DATA_DIR=/var/data

# ---------- Limits / tuning ----------
MAX_UPLOAD_MB=12
MAX_UPLOAD_FILES=6
MAX_INLINE_IMAGE_MB=9
MAX_AUDIO_MB=15
HISTORY_MESSAGES=24
MAX_CONTEXT_FILES_CHARS=180000
MAX_FILE_CHARS=40000
FEATHERLESS_MAX_TOKENS=4096
FEATHERLESS_TEMPERATURE=0.6
FEATHERLESS_TIMEOUT_MS=120000

# ---------- Rate limiting ----------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_API_MAX=600
RATE_LIMIT_CHAT_MAX=40
RATE_LIMIT_UPLOAD_MAX=60

# ---------- CORS ----------
# Only needed when hosting the frontend on a DIFFERENT origin (comma-separated).
# CORS_ORIGINS=https://prism-app.example.com
